# ==============================================================================
# TripMate Real Email Delivery Configuration
# To receive payment confirmations & invoices directly in your real Gmail / Outlook inbox:
#
# Quick Gmail Setup:
# 1. Go to Google Account (https://myaccount.google.com/security)
# 2. Ensure 2-Step Verification is ON
# 3. Search "App Passwords" -> Create one named "TripMate"
# 4. Paste your email and 16-character password below:
# ==============================================================================

# GMAIL Configuration (Easiest & Free)
GMAIL_USER=
GMAIL_PASS=

# Standard Custom SMTP Configuration (Alternative: Brevo, SendGrid, Mailtrap, Outlook)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
